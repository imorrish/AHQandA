{
  "name": "ahqanda",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/assets/styles.css --minify",
    "build:11ty": "eleventy --pathprefix=/AHQandA/",
    "build": "npm run build:css && npm run build:11ty",
    "dev:css": "tailwindcss -i ./src/styles/tailwind.css -o ./src/assets/styles.css --watch",
    "dev:11ty": "eleventy --serve --watch --port=7986",
    "dev": "concurrently \"npm:dev:css\" \"npm:dev:11ty\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "concurrently": "^9.1.2",
    "tailwindcss": "^3.4.17"
  }
}
