<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title or "AHQandA" }}</title>
    <link rel="stylesheet" href="{{ '/assets/styles.css' | url }}" />
  </head>
  <body class="min-h-screen bg-slate-950 text-slate-100">
    <header class="border-b border-slate-800">
      <div class="mx-auto max-w-5xl px-4 py-5">
        <div class="flex items-center justify-between gap-4">
          <a href="{{ '/' | url }}" class="text-lg font-semibold tracking-tight">AHQandA</a>
          {% if summaries and summaries.items and summaries.items.length %}
          {% set selectedSlug = currentSlug %}
          {% if not selectedSlug %}
            {% if page and page.url and (page.url | slice(0, 9)) == "/summary/" %}
              {% set selectedSlug = page.url | slice(9, 17) %}
            {% elseif page and page.url == "/" and summaries.latest %}
              {% set selectedSlug = summaries.latest.slug %}
            {% endif %}
          {% endif %}
          <form class="flex items-center gap-2" aria-label="Pick summary date">
            <label for="summaryPicker" class="text-sm text-slate-300">Date</label>
            <select
              id="summaryPicker"
              class="rounded-md border border-slate-700 bg-slate-900 px-3 py-2 text-sm text-slate-100"
              onchange="if(this.value){ window.location.href=this.value }"
            >
              {% for item in summaries.items %}
              <option value="{{ item.url | url }}" {% if selectedSlug == item.slug %}selected{% endif %}>
                {{ item.date | dateLabel }}
              </option>
              {% endfor %}
            </select>
          </form>
          {% endif %}
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
      {{ content | safe }}
    </main>

    <footer class="border-t border-slate-800">
      <div class="mx-auto max-w-5xl px-4 py-6 text-xs text-slate-400">
        <div class="flex flex-wrap items-center gap-3">
          <div>Built with Eleventy + TailwindCSS.</div>
          <a
            href="https://creativecommons.org/licenses/by/4.0/"
            target="_blank"
            rel="license noopener noreferrer"
            class="inline-flex items-center rounded-full border border-slate-700 bg-slate-900 px-2.5 py-1 text-xs font-semibold text-slate-200 hover:bg-slate-800"
            aria-label="Creative Commons Attribution 4.0 International (CC BY 4.0)"
          >
            Creative Commons Attribution 4.0 International (CC BY 4.0)
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
